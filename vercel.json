{
  "version": 2,
  "name": "ones-sky",
  "builds": [
    {
      "src": "onesky/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/onesky/$1"
    }
  ],
  "installCommand": "cd onesky && npm install",
  "buildCommand": "cd onesky && npm run build",
  "outputDirectory": "onesky/dist",
  "framework": null
}
