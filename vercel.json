{
  "version": 2,
  "builds": [
    {
      "src": "onesky/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/onesky/index.html"
    }
  ],
  "functions": {
    "backend/api/index.js": {
      "maxDuration": 10
    }
  }
}
